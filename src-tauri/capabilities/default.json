{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "shell:default",
    "fs:read-all",
    "fs:write-all",
    "notification:default",
    "notification:allow-check-permissions",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-fullscreen",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true,
          "sidecar": false
        },
        {
          "name": "open",
          "cmd": "open",
          "args": true,
          "sidecar": false
        },
        {
          "name": "lp",
          "cmd": "lp",
          "args": true,
          "sidecar": false
        },
        {
          "name": "xdg-open",
          "cmd": "xdg-open",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
